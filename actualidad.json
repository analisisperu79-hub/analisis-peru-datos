# ============================================================
# UTILIDADES
# ============================================================

def normalizar(texto):
    texto = texto or ""

    texto = unicodedata.normalize("NFKD", texto)

    texto = "".join(
        c for c in texto
        if not unicodedata.combining(c)
    )

    return texto.lower().strip()


def limpiar_texto(texto):
    if not texto:
        return ""

    texto = re.sub(r"\s+", " ", texto)

    return texto.strip()


def slug(texto):
    texto = normalizar(texto)

    texto = re.sub(
        r"[^a-z0-9\s-]",
        "",
        texto
    )

    texto = re.sub(
        r"[\s-]+",
        "-",
        texto
    )

    return texto.strip("-")[:80]


def descargar_html(url):
    respuesta = requests.get(
        url,
        headers=HEADERS,
        timeout=TIMEOUT
    )

    respuesta.raise_for_status()

    return respuesta.text


def parece_noticia(titulo):
    titulo_n = normalizar(titulo)

    if len(titulo_n) < 25:
        return False

    if len(titulo_n) > 220:
        return False

    if any(
        frase in titulo_n
        for frase in FRASES_PROHIBIDAS
    ):
        return False

    if not any(
        palabra in titulo_n
        for palabra in PALABRAS_ECONOMICAS
    ):
        return False

    return True


def descripcion_valida(texto):
    texto_n = normalizar(texto)

    if len(texto_n) < 70:
        return False

    if any(
        frase in texto_n
        for frase in BOILERPLATE
    ):
        return False

    return True


# ============================================================
# EXTRAER INFORMACIÓN DE UNA NOTICIA
# ============================================================

def extraer_fecha(soup):
    posibles = [
        soup.find(
            "meta",
            attrs={"property": "article:published_time"}
        ),
        soup.find(
            "meta",
            attrs={"name": "date"}
        ),
        soup.find(
            "meta",
            attrs={"name": "publication_date"}
        ),
    ]

    for elemento in posibles:

        if not elemento:
            continue

        valor = elemento.get("content")

        if not valor:
            continue

        fecha = interpretar_fecha(valor)

        if fecha:
            return fecha

    time_tag = soup.find("time")

    if time_tag:

        valor = (
            time_tag.get("datetime")
            or time_tag.get_text(
                " ",
                strip=True
            )
        )

        fecha = interpretar_fecha(valor)

        if fecha:
            return fecha

    # JSON-LD
    for script in soup.find_all(
        "script",
        attrs={"type": "application/ld+json"}
    ):

        try:
            datos = json.loads(
                script.string or "{}"
            )

            objetos = (
                datos
                if isinstance(datos, list)
                else [datos]
            )

            for objeto in objetos:

                if not isinstance(
                    objeto,
                    dict
                ):
                    continue

                valor = objeto.get(
                    "datePublished"
                )

                if valor:

                    fecha = interpretar_fecha(
                        valor
                    )

                    if fecha:
                        return fecha

        except Exception:
            pass

    return None


def interpretar_fecha(valor):
    if not valor:
        return None

    valor = limpiar_texto(valor)

    formatos = [
        "%Y-%m-%dT%H:%M:%S%z",
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%d",
        "%d/%m/%Y",
        "%d-%m-%Y",
    ]

    valor_limpio = valor.replace(
        "Z",
        "+00:00"
    )

    for formato in formatos:

        try:
            fecha = datetime.strptime(
                valor_limpio,
                formato
            )

            if fecha.tzinfo is None:
                fecha = fecha.replace(
                    tzinfo=timezone.utc
                )

            return fecha

        except Exception:
            continue

    match = re.search(
        r"(\d{1,2})[/\-](\d{1,2})[/\-](\d{4})",
        valor
    )

    if match:

        dia, mes, anio = map(
            int,
            match.groups()
        )

        try:
            return datetime(
                anio,
                mes,
                dia,
                tzinfo=timezone.utc
            )
        except Exception:
            pass

    return None


def extraer_resumen(soup):
    metas = [
        soup.find(
            "meta",
            attrs={"property": "og:description"}
        ),
        soup.find(
            "meta",
            attrs={"name": "description"}
        ),
    ]

    for meta in metas:

        if not meta:
            continue

        texto = limpiar_texto(
            meta.get(
                "content",
                ""
            )
        )

        if descripcion_valida(texto):
            return texto[:420]

    # Si los meta son institucionales,
    # buscamos un párrafo real.
    for p in soup.find_all("p"):

        texto = limpiar_texto(
            p.get_text(
                " ",
                strip=True
            )
        )

        if descripcion_valida(texto):

            if len(texto) > 420:
                texto = (
                    texto[:417]
                    .rsplit(
                        " ",
                        1
                    )[0]
                    + "..."
                )

            return texto

    return ""


def analizar_pagina(
    url,
    fuente,
    titulo
):

    try:
        html = descargar_html(url)
        soup = BeautifulSoup(
            html,
            "html.parser"
        )

        fecha = extraer_fecha(soup)
        resumen = extraer_resumen(soup)

        return {
            "fecha_obj": fecha,
            "resumen": resumen
        }

    except Exception as error:

        print(
            f"Error al analizar "
            f"{fuente}: {url} -> {error}"
        )

        return {
            "fecha_obj": None,
            "resumen": ""
        }


# ============================================================
# OBTENCIÓN DE ENLACES
# ============================================================

def obtener_enlaces_genericos(
    url,
    fuente,
    palabras_url=None
):
    resultados = []

    try:
        html = descargar_html(url)

        soup = BeautifulSoup(
            html,
            "html.parser"
        )

        for enlace in soup.find_all(
            "a",
            href=True
        ):

            titulo = limpiar_texto(
                enlace.get_text(
                    " ",
                    strip=True
                )
            )

            if not parece_noticia(
                titulo
            ):
                continue

            href = enlace["href"]

            final = urljoin(
                url,
                href
            )

            if palabras_url:

                url_n = normalizar(
                    final
                )

                if not any(
                    p in url_n
                    for p in palabras_url
                ):
                    continue

            resultados.append({
                "fuente": fuente,
                "titulo": titulo,
                "url_fuente": final
            })

    except Exception as error:

        print(
            f"Error {fuente}:",
            error
        )

    return resultados


