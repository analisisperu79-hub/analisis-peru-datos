# ============================================================
# CATEGORIZACIÓN
# ============================================================

def categorizar(titulo):
    t = normalizar(titulo)

    if any(
        p in t
        for p in [
            "inflacion",
            "ipc",
            "precio"
        ]
    ):
        return "Precios e inflación"

    if any(
        p in t
        for p in [
            "pbi",
            "produccion",
            "actividad economica",
            "crecimiento"
        ]
    ):
        return "Actividad económica"

    if any(
        p in t
        for p in [
            "exportacion",
            "importacion",
            "balanza comercial",
            "comercio exterior",
            "terminos de intercambio"
        ]
    ):
        return "Sector externo"

    if any(
        p in t
        for p in [
            "tipo de cambio",
            "dolar"
        ]
    ):
        return "Tipo de cambio"

    if any(
        p in t
        for p in [
            "tasa de referencia",
            "tasa de interes",
            "credito",
            "liquidez",
            "politica monetaria",
            "reservas internacionales"
        ]
    ):
        return "Monetario y financiero"

    if any(
        p in t
        for p in [
            "recaudacion",
            "tribut",
            "gasto publico",
            "deuda publica",
            "fiscal"
        ]
    ):
        return "Sector fiscal"

    if any(
        p in t
        for p in [
            "empleo",
            "desempleo",
            "ocupacion",
            "ingreso laboral",
            "remuneracion"
        ]
    ):
        return "Mercado laboral"

    return "Economía peruana"


# ============================================================
# BASE RELACIONADA
# ============================================================

BASES_URL = (
    "https://analisisperudatos.blogspot.com/"
    "p/bases-de-datos_01581930746.html"
)


def base_relacionada(titulo):
    t = normalizar(titulo)

    palabras = [
        "inflacion",
        "ipc",
        "pbi",
        "produccion",
        "exportacion",
        "importacion",
        "balanza comercial",
        "tipo de cambio",
        "tasa de referencia",
        "credito",
        "liquidez",
        "reservas internacionales",
        "terminos de intercambio",
    ]

    if any(
        p in t
        for p in palabras
    ):
        return BASES_URL

    return ""


# ============================================================
# PUNTUACIÓN
# ============================================================

def puntuacion(titulo, fecha):
    puntos = 0

    t = normalizar(titulo)

    palabras_alta_prioridad = [
        "pbi",
        "inflacion",
        "tasa de referencia",
        "produccion nacional",
        "empleo",
        "exportaciones",
        "importaciones",
        "tipo de cambio",
        "recaudacion",
    ]

    for palabra in palabras_alta_prioridad:

        if palabra in t:
            puntos += 3

    if fecha:

        ahora = datetime.now(
            timezone.utc
        )

        dias = (
            ahora - fecha
        ).days

        puntos += max(
            0,
            14 - dias
        )

    return puntos


# ============================================================
# PROCESAMIENTO
# ============================================================

def procesar_candidatas(candidatas):
    ahora = datetime.now(
        timezone.utc
    )

    limite = ahora - timedelta(
        days=DIAS_MAXIMOS
    )

    noticias = []

    urls_vistas = set()
    titulos_vistos = set()

    for candidata in candidatas:

        titulo = candidata["titulo"]
        url = candidata["url_fuente"]

        titulo_n = normalizar(
            titulo
        )

        if (
            url in urls_vistas
            or titulo_n in titulos_vistos
        ):
            continue

        urls_vistas.add(url)
        titulos_vistos.add(
            titulo_n
        )

        detalle = analizar_pagina(
            url,
            candidata["fuente"],
            titulo
        )

        fecha = detalle[
            "fecha_obj"
        ]

        # Si no conseguimos una fecha
        # confiable, no publicamos.
        if fecha is None:
            continue

        if fecha < limite:
            continue

        resumen = detalle[
            "resumen"
        ]

        if not resumen:
            continue

        categoria = categorizar(
            titulo
        )

        fecha_texto = fecha.strftime(
            "%d/%m/%Y"
        )

        noticias.append({
            "id": (
                fecha.strftime(
                    "%Y%m%d"
                )
                + "-"
                + slug(titulo)
            ),
            "fecha": fecha_texto,
            "fecha_iso": fecha.strftime(
                "%Y-%m-%d"
            ),
            "fuente": candidata[
                "fuente"
            ],
            "categoria": categoria,
            "titulo": titulo,
            "resumen": resumen,
            "url_fuente": url,
            "url_base": (
                base_relacionada(
                    titulo
                )
            ),
            "_fecha_obj": fecha,
            "_score": puntuacion(
                titulo,
                fecha
            )
        })

    noticias.sort(
        key=lambda n: (
            n["_fecha_obj"],
            n["_score"]
        ),
        reverse=True
    )

    noticias = noticias[
        :MAX_NOTICIAS
    ]

    for n in noticias:
        n.pop(
            "_fecha_obj",
            None
        )

        n.pop(
            "_score",
            None
        )

    return noticias


# ============================================================
# EJECUCIÓN
# ============================================================

def main():

    print(
        "Buscando actualidad "
        "económica del Perú..."
    )

    candidatas = []

    candidatas.extend(
        obtener_bcrp()
    )

    candidatas.extend(
        obtener_inei()
    )

    candidatas.extend(
        obtener_mef()
    )

    candidatas.extend(
        obtener_sunat()
    )

    print(
        "Candidatas encontradas:",
        len(candidatas)
    )

    noticias = procesar_candidatas(
        candidatas
    )

    salida = {
        "actualizado": (
            datetime.now(
                timezone.utc
            )
            .strftime(
                "%Y-%m-%d"
            )
        ),
        "total": len(noticias),
        "noticias": noticias
    }

    with open(
        ARCHIVO_SALIDA,
        "w",
        encoding="utf-8"
    ) as archivo:

        json.dump(
            salida,
            archivo,
            ensure_ascii=False,
            indent=2
        )

    print(
        "actualidad.json actualizado "
        f"con {len(noticias)} noticias."
    )


if __name__ == "__main__":
    main()
